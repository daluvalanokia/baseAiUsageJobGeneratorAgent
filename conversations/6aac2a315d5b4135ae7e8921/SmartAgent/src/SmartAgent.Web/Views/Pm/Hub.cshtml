@model SmartAgent.Core.Pm.ProgramPlan
@using SmartAgent.Core.Pm
@using SmartAgent.Web.Models
@{
    PmLayout.Apply(ViewData, Model);
    ViewData["PmNav"] = "overview";
    Layout = "_PmLayout";
    var platform = Model.Platform;
    var squadOfModule = new Func<string, string>(m => PmHub.SquadOfModule(Model, m));
}
<header>
    <h1>@Model.Name — @Model.Years-Year Agile Delivery Programme</h1>
    <p class="pm-sub">
        @(Model.SourceType): @Model.SourceName
        | @(platform?.Backend ?? "Platform")
        | @(platform?.PrimaryDb ?? "DB")@(platform is not null ? $" + {platform.SecondaryDb}" : "")
        | @Model.Sprints Sprints | @Model.Squads.Count Squads | @Model.Resources.Count Team Members
    </p>
    @if (!string.IsNullOrEmpty(Model.SourceDetail))
    {
        <p class="pm-sub">@Model.SourceDetail</p>
    }
</header>

<div class="pm-kpis">
    <div class="pm-kpi"><b>@Model.Sprints</b><span>SPRINTS</span></div>
    <div class="pm-kpi"><b>@Model.Weeks</b><span>WEEKS</span></div>
    <div class="pm-kpi"><b>@Model.Resources.Count</b><span>TEAM MEMBERS</span></div>
    <div class="pm-kpi"><b>@Model.TotalStoryPoints</b><span>STORY POINTS</span></div>
    <div class="pm-kpi"><b>@Model.UserStoryCount</b><span>USER STORIES</span></div>
    <div class="pm-kpi green"><b>@(Model.UnitTestCount + Model.SystemTestCount)</b><span>TEST CASES</span></div>
</div>

<div class="pm-card">
    <h3>Delivery Phases — framework → build → enhance → release</h3>
    @{
        var phaseSprints = Model.SprintPlans.GroupBy(s => s.Phase is { Length: > 0 } ? s.Phase : "build")
            .ToDictionary(g => g.Key, g => g.ToList());
        var phaseOrder = new[] { "framework", "build", "enhance", "release", "stabilization" };
        var phaseDesc = new Dictionary<string, string> {
            ["framework"] = "base framework code generation: scaffold, auth, tooling",
            ["build"] = "basic module functionality in vertical slices (db + server + controllers + frontend per sprint)",
            ["enhance"] = "field extensions and change patterns from the repository's commit history",
            ["release"] = "hardening, security review and the GA train",
            ["stabilization"] = "regression, hardening and readiness sprints" };
    }
    <table class="pm-tbl">
        <thead><tr><th>Phase</th><th>Sprints</th><th>Stories</th><th>Points</th><th>Focus</th></tr></thead>
        <tbody>
        @foreach (var ph in phaseOrder.Where(x => phaseSprints.ContainsKey(x)))
        {
            var (label, css) = PmPhaseBadge.Phase(ph);
            var sprintsIn = phaseSprints[ph];
            var keys = sprintsIn.SelectMany(x => x.StoryKeys).ToList();
            var pts = keys.Select(k => Model.Stories.FirstOrDefault(y => y.Key == k)).Where(y => y != null).Sum(y => y!.Points);
            <tr>
                <td><span class="pm-badge @css">@label</span></td>
                <td>@sprintsIn.Min(x => x.Number)–@sprintsIn.Max(x => x.Number) (@sprintsIn.Count)</td>
                <td>@keys.Count</td>
                <td>@pts</td>
                <td>@phaseDesc[ph]</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="pm-cols">
    <div class="pm-card">
        <h3>Quarter Schedule</h3>
        <table class="pm-tbl">
            <thead><tr><th>Quarter</th><th>Theme</th><th>Sprints</th><th>Weeks</th><th>Milestone</th></tr></thead>
            <tbody>
            @foreach (var q in Model.Quarters)
            {
                <tr>
                    <td><b>@q.Key</b></td>
                    <td>@q.Theme</td>
                    <td>@q.SprintFrom–@q.SprintTo</td>
                    <td>@q.WeekFrom–@q.WeekTo</td>
                    <td>
                        @if (!string.IsNullOrEmpty(q.Release))
                        {
                            <span class="pm-badge rel">@q.Release</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="pm-card">
        <h3>Squad Domains</h3>
        <table class="pm-tbl">
            <thead><tr><th>Squad</th><th>Domain</th><th>Epics</th><th>Members</th></tr></thead>
            <tbody>
            @foreach (var s in Model.Squads)
            {
                <tr>
                    <td><span class="pm-chip" style="background:@PmHub.SquadColor(s.Key)">@s.Key</span></td>
                    <td>@s.Domain</td>
                    <td>@s.EpicKeys.Count</td>
                    <td>@s.ResourceKeys.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (platform is not null)
{
    <div class="pm-card">
        <h3>● Platform Architecture — @platform.Name</h3>
        <div style="margin-bottom:10px">
            @foreach (var chip in platform.Infra)
            {
                <span class="dep-pill">@chip</span>
            }
            <span class="dep-pill">@platform.BackendLang</span>
            <span class="dep-pill">@platform.PrimaryDb</span>
        </div>
        <div class="pm-cols">
            <div>
                <h4 style="font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:.5px">Web Layer</h4>
                <ul style="font-size:12px;padding-left:18px;margin:4px 0 10px">@foreach (var x in platform.Arch.WebLayer)
                { <li>@x</li> }</ul>
                <h4 style="font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:.5px">Service Layer</h4>
                <ul style="font-size:12px;padding-left:18px;margin:4px 0 10px">@foreach (var x in platform.Arch.ServiceLayer)
                { <li>@x</li> }</ul>
            </div>
            <div>
                <h4 style="font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:.5px">Data Layer</h4>
                <ul style="font-size:12px;padding-left:18px;margin:4px 0 10px">@foreach (var x in platform.Arch.DataLayer)
                { <li>@x</li> }</ul>
                <h4 style="font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:.5px">Domain Tables</h4>
                <ul style="font-size:12px;padding-left:18px;margin:4px 0 10px">@foreach (var x in platform.Arch.DomainTables)
                { <li>@x</li> }</ul>
            </div>
        </div>
        <p style="font-size:11.5px;color:#6b7280;margin:8px 0 0"><b>Best for:</b> @platform.BestFor</p>
    </div>
}

<div class="pm-cols">
    <div class="pm-card">
        <h3>Budget — $@Model.Budget.TotalUsd.ToString("N0") total (@(Model.Budget.BudgetCapPerYearUsd > 0 ? $"cap ${Model.Budget.BudgetCapPerYearUsd:N0}/yr" : "uncapped"))</h3>
        <table class="pm-tbl">
            <thead><tr><th>Year</th><th>Cost</th><th>Within cap</th></tr></thead>
            <tbody>
            <tr><td>@Model.Years-year program</td><td>$@Model.Budget.TotalUsd.ToString("N0")</td>
                <td>@(Model.Budget.WithinCap ? "✅ yes" : "⚠️ over")</td></tr>
            </tbody>
        </table>
        <table class="pm-tbl" style="margin-top:10px">
            <thead><tr><th>Role</th><th>Cost</th></tr></thead>
            <tbody>
            @foreach (var rc in Model.Budget.CostByRole.Take(8))
            {
                <tr><td>@rc.Role</td><td>$@rc.CostUsd.ToString("N0")</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="pm-card">
        <h3>Role-Threaded Governor Outputs</h3>
        <table class="pm-tbl">
            <thead><tr><th>Role</th><th>Deliverable (threaded)</th></tr></thead>
            <tbody>
            @foreach (var ro in Model.RoleOutputs.OrderBy(kv => kv.Key))
            {
                <tr><td><b>@ro.Key</b></td><td>@(ro.Value.Length > 160 ? ro.Value[..159] + "…" : ro.Value)</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
